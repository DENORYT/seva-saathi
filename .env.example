# ── Gnani AI (Prisma STT + Timbre TTS) — get from app.gnani.ai/voice ──
GNANI_API_KEY=your_gnani_api_key_here

# ── STT config ──
# indic-auto + multi_lang_codes gives the multilingual Hindi+English model (Hinglish-safe)
GNANI_STT_LANG=indic-auto
GNANI_MULTI_LANG=en-IN,hi-IN
GNANI_STT_FALLBACK_LANG=hi-IN
GNANI_STT_FORMAT=transcribe

# ── TTS config (verified working: model timbre-v2.5) ──
TTS_MODEL=timbre-v2.5
TTS_VOICE=Kaveri

# ── LLM brain (OpenAI-compatible chat completions) ──
# Evon v3.3 via Hugging Face router:  LLM_BASE_URL=https://router.huggingface.co/v1
#   LLM_MODEL=<evon-model-id-from-hf>   LLM_API_KEY=<hf_token>
# Any OpenAI-compatible host also works (Groq/OpenRouter/z.ai/...): set base URL accordingly.
LLM_BASE_URL=https://router.huggingface.co/v1
LLM_MODEL=
LLM_API_KEY=

# ── Server ──
PORT=8787
